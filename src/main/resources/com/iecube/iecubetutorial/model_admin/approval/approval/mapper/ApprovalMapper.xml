<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--namespace 属性：用于指定当前的映射文件和哪个接口进行映射， 需要指定接口的文件路径， 需要标注包的完整路径接口-->
<mapper namespace="com.iecube.iecubetutorial.model_admin.approval.approval.mapper.ApprovalMapper">

    <resultMap id="Approval" type="com.iecube.iecubetutorial.model_admin.approval.approval.entity.Approval">
        <result column="approver_phone" property="approverPhone"></result>
        <result column="approval_type" property="approvalType"></result>
        <result column="create_time" property="createTime"></result>
        <result column="last_operate_time" property="lastOperateTime"></result>
        <result column="last_operator" property="lastOperator"></result>
    </resultMap>

    <insert id="createApproval" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO a_approval (`id`, `approval_type`, `approver_phone`, `status`, `reason`, `content`,
                                    `removed`, `create_time`, `creator`,`last_operate_time`,`last_operator`)
        VALUES (NULL, #{approvalType},#{approverPhone},#{status},#{reason},#{content},
                0,#{createTime},#{creator},#{lastOperateTime},#{lastOperator})
    </insert>

    <select id="getApproval" resultMap="Approval">
        SELECT `id`, `approval_type`, `approver_phone`, `status`, `reason`, `content`,
               `removed`, `create_time`, `creator`,`last_operate_time`,`last_operator`
        FROM a_approval
        WHERE id=#{id} AND removed=0
    </select>

    <update id="updateApproval">
        UPDATE a_approval SET `status`=#{status},
                              `removed`=#{removed},
                              `last_operate_time`=#{lastOperateTime},
                              `last_operator`=#{lastOperator}
        WHERE id=#{id}
    </update>

    <select id="getByApprover" resultMap="Approval">
        SELECT `id`, `approval_type`, `approver_phone`, `status`, `reason`, `content`,
               `removed`, `create_time`, `creator`,`last_operate_time`,`last_operator`
        FROM a_approval
        WHERE approver_phone=#{approver} AND removed=0 ORDER BY `create_time` DESC
    </select>

    <select id="getByCreator" resultMap="Approval">
        SELECT `id`, `approval_type`, `approver_phone`, `status`, `reason`, `content`,
               `removed`, `create_time`, `creator`,`last_operate_time`,`last_operator`
        FROM a_approval
        WHERE creator=#{creator} AND removed=0 ORDER BY `create_time` DESC
    </select>
</mapper>